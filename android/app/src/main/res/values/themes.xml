<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Obsidian window background so launch doesn't flash white before
         Compose takes over. The real theming lives in Compose (Theme.kt). -->
    <style name="Theme.Stackd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
