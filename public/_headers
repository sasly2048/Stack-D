# NOTE: this file does nothing on the current deployment.
#
# `_headers` is a Cloudflare **Pages** convention. This app builds to a
# Cloudflare **Worker** (Nitro's cloudflare_module preset), and Workers do not
# interpret it — the file is served as a static asset. Verified in production:
# GET /_headers returned 200 with this file's contents, and none of its rules
# appeared on any response.
#
# Security headers therefore live in `src/lib/security-headers.ts` and are
# applied in `src/server.ts`, which every response passes through.
#
# The caching rule below is emitted by the build and left as-is; it is
# duplicated by the asset pipeline rather than relied upon here.

/assets/*
  cache-control: public, max-age=31536000, immutable
